# iChat Pro production environment template.
# Copy to /opt/ichat/.env (chmod 600, owner ichat) and fill real values.
# NEVER commit the filled file or paste secrets into chat/issues/logs.

# Django core
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=__GENERATE_WITH__openssl_rand_hex_50__
DJANGO_ALLOWED_HOSTS=sub.example.com

# HTTPS origins allowed for POST (scheme + host[:port], comma separated).
# Must match what the browser address bar shows.
DJANGO_CSRF_TRUSTED_ORIGINS=https://sub.example.com:8443

# Database (PostgreSQL) — percent-encode special characters in the password.
DATABASE_URL=postgres://ichat:__DB_PASSWORD__@127.0.0.1:5432/ichat

# Redis Channel Layer + cache (loopback only; never expose publicly)
REDIS_URL=redis://127.0.0.1:6379/0

# Storage paths (persistent volume)
DJANGO_MEDIA_ROOT=/var/lib/ichat/media
DJANGO_STATIC_ROOT=/opt/ichat/staticfiles
