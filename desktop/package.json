{
  "name": "ichat-pro-desktop",
  "version": "1.0.0",
  "description": "iChat Pro desktop client",
  "main": "main.js",
  "author": "iChat Pro Team",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win nsis",
    "test:installer": "node scripts/test-installer.cjs",
    "test:branding": "node scripts/test-branding.cjs"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^25.1.8",
    "rcedit": "^5.0.0"
  },
  "build": {
    "appId": "pro.ichat.desktop",
    "productName": "iChat Pro",
    "copyright": "Copyright © 2026 iChat Pro Team",
    "files": [
      "main.js",
      "app-config.js",
      "app-branding.js",
      "defaults.json",
      "preload.js",
      "offline.html"
    ],
    "extraResources": [
      { "from": "build/icon.ico", "to": "branding/icon.ico" },
      { "from": "build/icon.png", "to": "branding/icon.png" }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "iChat-Pro-Setup-${version}.${ext}",
      "allowElevation": true,
      "include": "build/installer.nsh"
    },
    "afterPack": "scripts/afterPack.cjs"
  }
}
