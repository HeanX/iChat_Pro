# iChat Pro STAGING environment template (P4 T49 / Issue #176).
#
# Copy to /opt/ichat-staging/.env (chmod 600, owner <staging user>) and fill
# real values. EVERY value below must differ from production — the acceptance
# criterion for T49 is "isolated from production config, data and secrets",
# and the isolation check (deploy/staging/check_isolation.sh) verifies it.
#
# NEVER copy the production /opt/ichat/.env. A shared SECRET_KEY would let a
# staging-compromised value forge production session/CSRF/signed cookies;
# shared DB credentials would make "test data" a production hazard.

# --- identity: staging must be unmistakable -------------------------------
DJANGO_DEBUG=False
# Generate fresh: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=__GENERATE_FRESH_NEVER_COPY_FROM_PROD__
DJANGO_ALLOWED_HOSTS=staging.example.com,127.0.0.1
# Staging origin (its own port / subdomain, never the production origin)
DJANGO_CSRF_TRUSTED_ORIGINS=https://staging.example.com:8444

# --- data: its own database, own Redis logical db -------------------------
# Database name ichat_staging (production is ichat) with its OWN role and
# password — never the production role.
DATABASE_URL=postgres://ichat_staging:__STAGING_DB_PASSWORD__@127.0.0.1:5432/ichat_staging
# Redis db 1 (production uses db 0). Same server is acceptable for t3.small;
# logical separation keeps channel layers and caches from colliding.
REDIS_URL=redis://127.0.0.1:6379/1

# --- storage: own media + static roots ------------------------------------
DJANGO_MEDIA_ROOT=/var/lib/ichat-staging/media
DJANGO_STATIC_ROOT=/opt/ichat-staging/staticfiles

# --- deployment wiring: COMMAND LINE ONLY (never in this file) -------------
# IMPORTANT (review finding F-01): deploy.sh accepts the deployment identity
# ONLY from the caller's environment. If any of the keys below appears in this
# file, deploy.sh refuses to run at all (exit 2). That is deliberate: a tree
# that can choose which systemd unit to restart, which ports to probe and who
# the release is attributed to would be authorising its own deployment.
#
# The values are therefore NOT read from here. Export them on the deploy
# command line instead (see runbook §3c):
#
#   sudo ICHAT_APP_DIR=/opt/ichat-staging \
#        ICHAT_MEDIA_DIR=/var/lib/ichat-staging/media \
#        ICHAT_SERVICE_NAME=ichat-staging \
#        ICHAT_SERVICE_USER=ichat-staging \
#        ICHAT_TLS_PORT=8444 \
#        ICHAT_HTTP_PORT=8001 \
#        ICHAT_REQUIRE_APPROVAL=0 \
#        /opt/ichat-staging/bin/deploy.sh --branch main
#
# Readiness / smoke origins are derived from the two ports (production is
# 8443/8000). Nginx must expose staging on 8444 and Daphne listens on 8001.
# Optional, same rule — command line only:
#   ICHAT_READY_ORIGIN=https://127.0.0.1:8444
#   ICHAT_LOOPBACK_ORIGIN=http://127.0.0.1:8001
#
# The systemd unit passes the same values to the running service through its
# own EnvironmentFile, so the service and the deploy still agree on identity.


# --- smoke gate: staging has its OWN smoke account ------------------------
SMOKE_USERNAME=staging_smoke
SMOKE_PASSWORD=__STAGING_SMOKE_PASSWORD_NEVER_SHARED_WITH_PROD__
