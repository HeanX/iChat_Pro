[Unit]
Description=iChat Pro ASGI (Daphne)
After=network-online.target postgresql.service redis6.service
Wants=network-online.target

[Service]
Type=exec
User=ichat
Group=ichat
WorkingDirectory=/opt/ichat/repo
EnvironmentFile=/opt/ichat/.env
ExecStart=/opt/ichat/.venv/bin/daphne -b 127.0.0.1 -p 8000 ichat_pro.asgi:application
Restart=always
RestartSec=3
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/ichat

[Install]
WantedBy=multi-user.target
