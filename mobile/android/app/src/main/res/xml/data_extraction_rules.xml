<?xml version="1.0" encoding="utf-8"?>
<!--
  P4 T22 / ADR-P4-03 §7: exclude every app data domain from Android 12+
  cloud backup and device-to-device transfer.

  Long-term E2EE private keys sit in WebView storage and are not covered by the
  Android Keystore, so they must not leave the device through a backup. When
  T29 (#156) moves keys behind the Keystore, revisit this file rather than
  silently widening the rules.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
